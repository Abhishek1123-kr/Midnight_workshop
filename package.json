    "axios": "^1.17.0",
    "buffer": "^6.0.3",
    "fp-ts": "^2.16.11",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.17.0",
    "rxjs": "^7.8.2",
    "semver": "^7.8.4",
    "ws": "^8.21.0"
  },
