{
  "name": "journal-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "compact": "wsl /home/abhishek/.local/bin/compact compile contracts/journal.compact ./managed/journal",
    "test": "vitest run tests/journal.test.ts",
    "dev": "vite",
    "build": "tsc && vite build --mode preprod && wsl cp -r ./managed/journal/keys ./dist/keys && wsl cp -r ./managed/journal/zkir ./dist/zkir",
    "deploy": "node --experimental-specifier-resolution=node --loader ts-node/esm scripts/deploy.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
